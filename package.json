{
  "name": "quant-cloud-environment-backup-action",
  "version": "1.1.0",
  "description": "GitHub Action for creating and managing backups of environments in Quant Cloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "./node_modules/.bin/ncc build src/index.ts -o dist",
    "test": "jest",
    "test:local": "npm run build && node test-local.js",
    "test:ops": "node test-operations.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@quantcdn/quant-client": "^4.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/node_modules/@actions/core/lib/core.js"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node"
          }
        }
      ]
    }
  }
}
